# --- Google Sheets ---
# Service account JSON key (same setup as the Alumni Database: the account's
# client_email must be an Editor on the sheet).
GOOGLE_SHEETS_CREDENTIALS_FILE=credentials.json

# Company_Outreach_Tracker:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=

# Tab holding the COMPANY / INDUSTRY / LINKEDIN PAGE list. The header row is
# found by its COMPANY cell, so rows above it can change freely. Companies
# with no LINKEDIN PAGE are skipped until someone fills it in.
TRACKER_TAB=Sheet10
# Created on the first run if missing.
RESULTS_TAB=Hiring Managers
LOG_TAB=Search Log

# --- Apify ---
# https://console.apify.com/settings/integrations -> API token.
# Searches run on harvestapi/linkedin-company-employees: US$0.003 per profile,
# US$0.02 per run (free plan, 7 Oct 2026).
APIFY_TOKEN=

# Apify's free plan includes US$5 of usage a month. Each run is logged in
# LOG_TAB at its expected cost before it starts, and no run starts that
# could take the month past this.
APIFY_MONTHLY_BUDGET_USD=4.50

# Apify free plan (chosen 7 Oct 2026): HarvestAPI allows free accounts only
# FREE_RUNS_PER_MONTH runs and 25 profiles per run. The script counts this
# month's runs on Apify before starting, sizes runs to fit, does every
# company's first search before any fallback, and leaves the rest due for
# next month. Set FREE_PLAN=false on a paid Apify plan.
FREE_PLAN=true
FREE_RUNS_PER_MONTH=10

# Profiles fetched per company per stage; the ranking keeps the best of them.
# On the free plan 3 x 8 companies = 24 fits the 25-per-run limit.
PROFILES_PER_COMPANY=3

# Companies per Apify run on a paid plan (free plan: 25 // PROFILES_PER_COMPANY).
# The US$0.02 start fee is charged per company either way.
BATCH_SIZE=20

# A company is searched again this many months after its last successful search.
RESEARCH_INTERVAL_MONTHS=3

# Only people based in these cities are searched for, and can be a Strong
# match (semicolon-separated; the first is preferred).
CITIES=Melbourne;Sydney

# How many people per company are written to the sheet, best first.
CONTACTS_PER_COMPANY=2

# Stage 1 job titles (LinkedIn matches any). Stage 2 runs only for companies
# with no Strong match after stage 1; leave FALLBACK_TITLES blank to skip it.
EARLY_TITLES=Early Careers;Graduate;Campus;Emerging Talent;Talent Programs;Intern;University
FALLBACK_TITLES=Talent Acquisition;Recruitment;Recruiter;Talent Attraction

# Titles for the tracker's SEARCH AS = Marketing team / Leadership companies.
MARKETING_TITLES=Student Marketing;Brand Manager;Marketing Manager;Head of Marketing;Marketing Director
LEADERSHIP_TITLES=Founder;Co-Founder;Managing Director;General Manager;Head of People;People & Culture;Director

# Give up on (and abort) a run that takes longer than this.
RUN_TIMEOUT_SECS=900

LOG_LEVEL=INFO
